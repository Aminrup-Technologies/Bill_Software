<%@ Register Src="~/corporate/business/app/GlobalNotification.ascx" TagPrefix="uc" TagName="GlobalNotification" %>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <link href="../../WebProperty/css/style.css" rel="stylesheet" type="text/css" />
    <link href="../../WebProperty/css/menu.css" rel="stylesheet" type="text/css" />
    <script type="text/javascript" src="../../WebProperty/js/clock.js"></script>
    <title>FLAME-EX</title>
    <link rel="shortcut icon" href="../WebImages/aagrouplogo.png" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <style type="text/css">
        html, body { height: 100%; margin: 0; overflow: hidden; }
        form {
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
            margin: 0;
        }

        .top-header-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            min-height: 60px;
            height: auto;
            width: 100%;
            background-color: #2268a9;
            padding: 10px 12px;
            box-sizing: border-box;
            position: relative;
            z-index: 999;
            box-shadow: 0 2px 6px rgba(0,0,0,0.2);
            flex-shrink: 0;
        }

        .header-brand { flex-shrink: 0; display: flex; align-items: center; gap: 8px; }

        .header-logo {
            object-fit: contain;
            background-color: #fff;
            border-radius: 4px;
            padding: 1px;
            height: 40px !important;
            width: 50px !important;
        }

        .header-company {
            color: #fff;
            font: bold 14px/1.2 Arial, Helvetica, sans-serif;
            white-space: nowrap;
        }

        .main-nav { flex: 1; display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin: 0 15px; padding-bottom: 2px; min-width: 0; }

        .main-nav .menu { width: 100%; background: none; float: none; }
        .main-nav #nav {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
            margin: 0;
        }
        .main-nav #nav > li {
            float: none;
            line-height: 28px;
            height: auto;
            color: #fff;
            padding: 0 8px;
            border-right: 1px solid rgba(255,255,255,0.25);
            font: normal 11px/28px Arial, Helvetica, sans-serif;
            white-space: nowrap;
        }
        .main-nav #nav > li:hover,
        .main-nav #nav > li:hover > a { background: #1a4f80; color: #fff; }
        .main-nav .menu ul { z-index: 1000; }

        .header-profile { flex-shrink: 0; display: flex; align-items: center; gap: 10px; }

        .top-header-bar .clock_style {
            margin: 0;
            float: none;
            font-size: 16px;
            line-height: 1;
        }

        .header-user {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #fff;
        }

        .header-user-text { display: flex; flex-direction: column; text-align: right; line-height: 1.2; }
        .header-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #fff;
        }

        .top-header-bar .logout {
            color: #fff;
            padding: 0 0 0 20px;
            white-space: nowrap;
            line-height: 18px;
        }

        .app-content {
            flex: 1;
            min-height: 0;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 15px;
            background: #f4f7f6;
            position: relative;
            box-sizing: border-box;
        }

        .app-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-shrink: 0;
            background: #f8f9fa;
            border-top: 1px solid #ddd;
            z-index: 10;
            padding: 8px 15px;
            font: normal 11px/18px Arial, Helvetica, sans-serif;
            color: #666;
        }

        .support-btn-floating {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background-color: #2268a9;
            color: white;
            padding: 10px 15px;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
            font-family: Arial, sans-serif;
            font-weight: bold;
            z-index: 1000;
        }

        .support-modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.6);
            z-index: 1001;
        }

        .support-modal-box {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: white;
            padding: 20px;
            width: 400px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            font-family: Arial, sans-serif;
        }

        .support-close {
            float: right;
            cursor: pointer;
            font-size: 18px;
            font-weight: bold;
            color: #666;
        }

        .support-input {
            width: 95%;
            margin-top: 10px;
            margin-bottom: 10px;
            padding: 5px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        .support-submit {
            background-color: #2268a9;
            color: white;
            border: none;
            padding: 8px 15px;
            cursor: pointer;
            border-radius: 4px;
            margin-top: 15px;
        }

    </style>

    <script>
        var _paq = window._paq = window._paq || [];
        _paq.push(['trackPageView']);
        _paq.push(['enableLinkTracking']);
        (function () {
            var u = "//visitors.aminruptechnologies.co.in/";
            _paq.push(['setTrackerUrl', u + 'matomo.php']);
            _paq.push(['setSiteId', '1']);
            var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
            g.async = true; g.src = u + 'matomo.js'; s.parentNode.insertBefore(g, s);
        })();
    </script>

    <script type="text/javascript">
        function pingServerHeartbeat() {
            fetch('/corporate/business/app/Heartbeat.ashx', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(response => response.json())
            .then(data => {
                if (data.status === 'logout') {
                    let msg = "You have been logged out.";
                    if (data.reason === 'superseded') msg = "You have been logged out because your account was signed in from another device.";
                    else if (data.reason === 'timeout') msg = "Your session has expired due to inactivity.";
                    alert(msg);
                    window.location.href = '/index.aspx';
                }
            })
            .catch(error => console.error('Heartbeat failed:', error));
        }
        setInterval(pingServerHeartbeat, 120000);

        function toggleSupportModal() {
            var modal = document.getElementById('supportModal');
            modal.style.display = modal.style.display === 'block' ? 'none' : 'block';
        }

        function takeAutoScreenshot() {
            var captureBtn = document.getElementById('btnCaptureScreen');
            captureBtn.innerHTML = "Capturing... Please wait.";
            captureBtn.disabled = true;
            var modal = document.getElementById('supportModal');
            modal.style.display = 'none';

            html2canvas(document.body).then(function (canvas) {
                var base64data = canvas.toDataURL('image/png');
                document.getElementById('<%= hfAutoScreenshot.ClientID %>').value = base64data;
                var preview = document.getElementById('imgScreenshotPreview');
                preview.src = base64data;
                preview.style.display = 'block';
                modal.style.display = 'block';
                captureBtn.innerHTML = "Screen Captured! ✓";
                captureBtn.style.backgroundColor = "green";
            });
        }
    </script>
</head>

