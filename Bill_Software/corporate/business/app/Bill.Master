            </div>

            <div class="support-btn-floating" onclick="toggleSupportModal()">💬 Raise a Concern</div>
            <div id="supportModal" class="support-modal-overlay">
                <div class="support-modal-box">
                    <span class="support-close" onclick="toggleSupportModal()">&times;</span>
                    <h3 style="margin-top: 0; color: #2268a9;">IT Support Request</h3>
                    <p style="font-size: 12px; color: #666;">Describe your issue. The IT team will automatically receive your details and current page.</p>

                    <asp:TextBox ID="txtSupportMessage" runat="server" TextMode="MultiLine" Rows="4" CssClass="support-input" placeholder="Type your issue here..."></asp:TextBox>

                    <div style="margin-bottom: 15px; border: 1px dashed #ccc; padding: 10px; border-radius: 4px; text-align: center;">
                        <button type="button" id="btnCaptureScreen" onclick="takeAutoScreenshot()" style="background-color: #e0a800; color: white; border: none; padding: 5px 10px; cursor: pointer; border-radius: 3px;">
                            📸 Capture Current Page
                        </button>
                        <asp:HiddenField ID="hfAutoScreenshot" runat="server" />
                        <img id="imgScreenshotPreview" style="display: none; max-width: 100px; max-height: 100px; margin-top: 10px; border: 1px solid #999;" />
                    </div>

                    <label style="font-size: 12px; font-weight: bold;">Screenshot (Optional):</label>
                    <asp:FileUpload ID="fileScreenshot1" runat="server" CssClass="support-input" />
                    <asp:Button ID="btnSubmitSupport" runat="server" Text="Submit Concern" CssClass="support-submit" OnClick="btnSubmitSupport_Click" />
                    <br />
                    <asp:Label ID="lblSupportStatus" runat="server" ForeColor="Green" Font-Size="12px" Font-Bold="true"></asp:Label>
                </div>
            </div>
        </form>

        <br class="clear" />
        <div class="style1">
            <table width="90%" border="0" cellspacing="0" cellpadding="0" style="margin: 0 auto;">
                <tr>
                    <td width="34%" height="36">&nbsp;
                        <asp:Image ID="Image3" runat="server" ImageUrl="~/corporate/business/WebImages/oh4y.png" Width="25px" />&nbsp;<sup><asp:Label ID="lbl_crntyr" runat="server" Text="2026"></asp:Label></sup></td>
                    <td width="37%">&nbsp;</td>
                    <td width="29%" align="right"><sup>©</sup><a href="https://www.aminruptechnologies.co.in/" target="_blank" style="text-decoration: none;">Aminrup Technologies, JSR</a></td>
                </tr>
            </table>
        </div>
    </div>
</body>
</html>
